# Copy to `.env.local` (gitignored) for development, and set the same variables
# in the Vercel dashboard for production. Everything here ships in the public
# browser bundle — never put a secret / service_role key in a VITE_ variable.

# Canonical origin, used by the SEO pipeline for canonicals, sitemaps and OG images.
VITE_SITE_URL=https://keytopia.app

# IndexNow key (optional). Invent any 8–128 character [a-zA-Z0-9-] string; the
# build publishes it at /<key>.txt as ownership proof, and `npm run seo:ping`
# pushes every URL to Bing, Yandex, Naver and Seznam after a deploy.
# VITE_INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Supabase. Two environments, same two variables.
#
# LOCAL (the default for development): `npm run db:start` boots Postgres + auth
# in Docker and prints these. The local key is a fixed demo credential — it is
# identical on every machine and grants nothing outside your laptop.
#
#   VITE_SUPABASE_URL=http://127.0.0.1:54421
#   VITE_SUPABASE_PUBLISHABLE_KEY=<the "anon key" printed by db:start>
#
# PRODUCTION: the hosted project's URL and publishable key, set in the Vercel
# dashboard rather than in any file. The publishable key is meant to be public;
# row-level security is what protects the data. The *secret* key belongs in the
# Supabase dashboard only — in a VITE_ variable it would land in the bundle and
# bypass every policy.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave both unset to run KeyTopia fully local-first: sign-in UI hides itself and
# the sync layer stays a no-op.

# ---------------------------------------------------------------------------
# Deploy scripts only — none of these are VITE_ variables, so they never reach
# the browser bundle. Used by `npm run deploy:templates` and `npm run setup:resend`.
#
#   SUPABASE_ACCESS_TOKEN   personal token, https://supabase.com/dashboard/account/tokens
#   SUPABASE_PROJECT_REF    defaults to xfthivblhhbhokcptygh if unset
#   RESEND_API_KEY          https://resend.com/api-keys (starts with re_)
#   SMTP_SENDER_EMAIL       defaults to hello@keytopia.app
# ---------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=
# RESEND_API_KEY=
# SMTP_SENDER_EMAIL=hello@keytopia.app
